@PACKAGE_INIT@

set(BLITZAR_VERSION "@PROJECT_VERSION@")
set(BLITZAR_PRODUCT_VERSION "@PROJECT_VERSION@")
set(BLITZAR_PLAN_VERSION "@BLITZAR_PLAN_VERSION@")
set(BLITZAR_HDF5_ENABLED "@BLITZAR_HDF5_ENABLED@")

include(CMakeFindDependencyMacro)

if("@BLITZAR_ENABLE_OPENMP@" STREQUAL "ON")
    find_dependency(OpenMP COMPONENTS CXX)
endif()

if("@BLITZAR_MPI_ENABLED@" STREQUAL "ON")
    find_dependency(MPI COMPONENTS CXX)
endif()

if("@BLITZAR_HDF5_ENABLED@" STREQUAL "ON")
    find_dependency(HDF5 COMPONENTS C)
endif()

if("@BLITZAR_HIP_ENABLED@" STREQUAL "ON")
    if("@BLITZAR_HIP_LANGUAGE@" STREQUAL "CUDA")
        find_dependency(CUDAToolkit)
    endif()
    if("@BLITZAR_HIP_PACKAGE@" STREQUAL "hip")
        find_dependency(hip CONFIG)
    elseif("@BLITZAR_HIP_PACKAGE@" STREQUAL "HIP")
        find_dependency(HIP CONFIG)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/BLITZARTargets.cmake")

check_required_components(BLITZAR)
