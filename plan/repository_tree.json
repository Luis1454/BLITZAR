{
  "schema_version": 1,
  "plan_version": "1.0.61",
  "status": "frozen",
  "materialization": "planned",
  "description": "Frozen repository taxonomy, language separation, naming, and source-test layout contract.",
  "aliases": {
    "barnes_hut": "bh",
    "config": "cfg",
    "diagnostics": "diag",
    "initialization": "init",
    "metadata": "md",
    "postprocess": "post",
    "snapshot": "snap",
    "staging": "stage",
    "transaction": "tx"
  },
  "language_separation": [
    {
      "root": "include/blitzar",
      "children": [
        "c",
        "cpp"
      ]
    },
    {
      "root": "tests/contracts",
      "children": [
        "c",
        "cpp"
      ]
    },
    {
      "root": "examples",
      "children": [
        "c",
        "cpp"
      ]
    }
  ],
  "source_test_pairs": [
    {
      "source": "src/solvers",
      "tests": "tests/solvers",
      "responsibility": "solver families and variants"
    },
    {
      "source": "src/grid",
      "tests": "tests/grid",
      "responsibility": "grid layout and resource"
    },
    {
      "source": "src/trees/octree",
      "tests": "tests/trees/octree",
      "responsibility": "Octree construction, views, and resources"
    },
    {
      "source": "src/gpu",
      "tests": "tests/gpu",
      "responsibility": "GPU runtime and solver capabilities"
    },
    {
      "source": "src/io",
      "tests": "tests/io",
      "responsibility": "persistence and post-processing"
    },
    {
      "source": "src/mpi",
      "tests": "tests/mpi",
      "responsibility": "MPI ownership, exchange, and overlap"
    },
    {
      "source": "src/simulation",
      "tests": "tests/simulation",
      "responsibility": "simulation lifecycle and configuration"
    },
    {
      "source": "src/integration",
      "tests": "tests/integration",
      "responsibility": "integrator qualification"
    }
  ],
  "allowed_missing": [
    {
      "source": "src/solvers/direct",
      "tests": "tests/solvers/direct",
      "reason": "The Direct oracle is currently exercised through contract and cross-solver tests."
    },
    {
      "source": "src/solvers/bh",
      "tests": "tests/solvers/bh",
      "reason": "A dedicated Barnes-Hut responsibility test will be added when the solver test split is materialized."
    },
    {
      "source": "src/solvers/threading",
      "tests": "tests/solvers/threading",
      "reason": "Thread traversal resources are currently covered by solver qualification boundaries."
    },
    {
      "source": "src/gpu/direct",
      "tests": "tests/gpu/direct",
      "reason": "GPU Direct remains capability-gated and has no separate test executable yet."
    },
    {
      "source": "src/gpu/bh",
      "tests": "tests/gpu/bh",
      "reason": "GPU Barnes-Hut remains capability-gated and has no separate test executable yet."
    }
  ],
  "test_suffix": {
    "suffix": "Test",
    "extensions": [
      ".c",
      ".cpp",
      ".cmake"
    ],
    "entrypoint_policy": "every registered test entrypoint below tests/ ends with Test before its extension",
