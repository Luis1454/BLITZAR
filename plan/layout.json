    "representation_equivalent",
    "tree_valid"
  ],
  "invariants": [
    "ordering is sorted by Morton key and original particle index",
    "comparison and radix ordering hashes are identical for every particle count",
    "all candidate layouts materialize identical logical state and Octree bytes",
