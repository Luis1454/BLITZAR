        {"path": "apps/blitzar", "prefix": "Blitzar"},
        {"path": "tests/contracts", "prefix": "Contract"},
        {"path": "tests/fixtures", "prefix": "Fixture"},
        {"path": "tests/fmm", "prefix": "Fmm"},
        {"path": "tests/gpu", "prefix": "Gpu"},
        {"path": "tests/integration", "prefix": "Kdk"},
        {"path": "tests/mpi", "prefix": "Mpi"},
        {"path": "tests/octree", "prefix": "Octree"},
        {"path": "tests/scaling", "prefix": "Scale"},
        {"path": "tests/simulation", "prefix": "Sim"},
        {"path": "examples/c", "prefix": "C"},
        {"path": "examples/cpp", "prefix": "Cpp"}
      ],
      "type_mapping_exceptions": [
        {
          "path": "src/core/CoreExecution.hpp",
          "reason": "value-type contract header for ExecutionSettings"
        },
        {
          "path": "src/core/CoreSnapshot.hpp",
          "reason": "value-type contract header for SnapshotHeader and SnapshotFrameView"
        },
        {
          "path": "src/core/CoreStatus.hpp",
          "reason": "free-function status contract header"
        },
        {
          "path": "src/core/CoreTypes.hpp",
          "reason": "shared view and scalar contract header"
        },
        {
          "path": "src/core/CoreUnits.hpp",
          "reason": "value-type contract header for UnitSystem"
        },
        {
          "path": "src/gpu/runtime/GpuTransfer.hpp",
          "reason": "CUDA/HIP runtime bridge contract"
        },
        {
          "path": "src/gpu/runtime/GpuCompatibility.hpp",
          "reason": "CUDA compatibility declaration header"
        },
        {
      "path": "src/mpi/domain/MpiDomainBounds.hpp",
      "reason": "MpiDomainBounds value contract"
        },
        {
          "path": "src/mpi/runtime/MpiState.hpp",
          "reason": "MpiContext state fragment"
        },
        {
          "path": "src/mpi/native/MpiNativeState.hpp",
          "reason": "MpiNative opaque state fragment"
        },
        {
          "path": "tests/mpi/MpiCases.hpp",
          "reason": "MPI test-case facade and StateArrays value contract"
        }
      ],
      "standalone_implementation_exceptions": [
        {
          "path": "tests/contracts/ContractDebugStatusTest.cpp",
          "reason": "standalone debugger exit-status probe"
        }
      ],
      "forbidden_path_components": ["utils", "common", "misc", "private", "details"],
      "forbidden_name_prefixes": [
        "Srv", "Server", "Legacy", "Old", "Temp", "Utils", "Common", "Misc", "Private", "Details"
      ]
    }
  },
  "format": {
    "command": "python -m tools.format.format_clang_gate --root . --check",
