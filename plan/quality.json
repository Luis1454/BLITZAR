  "architecture": {
    "report_schema": 2,
    "command": "python -B tools/architecture_report.py --root . --all --check",
    "review_registry": "plan/architecture_reviews.json",
    "line_count_policy": "informational",
    "thresholds": {
      "max_parameters": 4,
      "max_function_lines": 80,
      "max_functions_per_file": 12,
      "max_branch_points": 12,
      "max_allocation_sites": 8,
      "max_internal_includes": 12
    },
    "profiles": {
      "production": {
        "roots": ["include", "src", "apps"],
        "suffixes": [".c", ".cc", ".cpp", ".cu", ".cuh", ".h", ".hip", ".hpp", ".inl"]
      },
      "tests": {
        "roots": ["tests"],
        "suffixes": [".c", ".cc", ".cpp", ".cu", ".cuh", ".cmake", ".h", ".hip", ".hpp", ".inl"]
      },
      "examples": {
        "roots": ["examples"],
        "suffixes": [".c", ".cc", ".cpp", ".cu", ".cuh", ".h", ".hip", ".hpp", ".inl"]
      },
      "tools": {
        "roots": ["tools"],
        "suffixes": [".py"],
        "thresholds": {
          "max_functions_per_file": 20,
          "max_allocation_sites": 40
        }
      },
      "build-metadata": {
        "paths": ["CMakeLists.txt", ".clang-format", ".gitattributes", ".gitignore"],
        "roots": ["cmake", ".github"],
        "suffixes": [".cmake", ".in", ".yml", ".yaml"]
      },
      "documentation": {
        "paths": ["PLAN.md", "AGENTS.md"],
        "roots": ["plan"],
        "suffixes": [".json", ".md"]
      }
    },
    "source_completeness": {
      "cmake_files": ["CMakeLists.txt"],
      "source_roots": ["src", "apps", "examples", "tests"],
      "suffixes": [".c", ".cc", ".cpp", ".cu", ".hip"]
    },
    "naming": {
      "max_filename_length": {
        "production": 32,
        "tests": 32,
        "examples": 32,
        "tools": 32,
        "build-metadata": 48,
        "documentation": 64
      },
      "allowed_stem_pairs": [
        {"extensions": [".cpp", ".hpp"], "reason": "implementation/header pair"},
        {"extensions": [".cc", ".h"], "reason": "implementation/header pair"},
        {"extensions": [".cu", ".cuh"], "reason": "CUDA implementation/header pair"},
        {"extensions": [".hip", ".hpp"], "reason": "HIP implementation/header pair"},
        {"extensions": [".h", ".hpp"], "reason": "public ABI header pair"}
      ],
      "name_exceptions": [
        {
          "path": "include/blitzar/blitzar.h",
          "reason": "stable public C ABI spelling"
        },
        {
          "path": "include/blitzar/blitzar.hpp",
          "reason": "stable public C++ wrapper spelling"
        },
        {
          "path": "cmake/BLITZARConfig.cmake.in",
          "reason": "canonical CMake package template name"
        }
      ],
      "type_mapping_exceptions": [
        {
          "path": "src/core/Units.hpp",
          "reason": "value-type contract header for UnitSystem"
        },
        {
          "path": "src/gpu/CudRuntime.hpp",
          "reason": "CUDA/HIP runtime bridge contract"
        },
        {
          "path": "src/gpu/HipCompat.hpp",
          "reason": "CUDA compatibility declaration header"
        },
        {
          "path": "src/parallel/Bounds.hpp",
          "reason": "DomainBounds value contract"
        },
        {
          "path": "src/parallel/MpiContextState.hpp",
          "reason": "MpiContext state fragment"
        },
        {
          "path": "src/parallel/MpiNativeState.hpp",
          "reason": "MpiNative opaque state fragment"
        },
        {
          "path": "tests/MpiCases.hpp",
          "reason": "MPI test-case facade and StateArrays value contract"
        }
      ],
      "standalone_implementation_exceptions": [
        {
          "path": "tests/DebugStatus.cpp",
          "reason": "standalone debugger exit-status probe"
        }
      ],
      "forbidden_path_components": ["utils", "common", "misc", "private", "details"],
      "forbidden_name_prefixes": [
        "Srv", "Server", "Legacy", "Old", "Temp", "Utils", "Common", "Misc", "Private", "Details"
      ]
    }
  },
  "format": {
    "command": "python tools/clang_format_gate.py --root . --check",
    "clang_format_version": "22.1.8",
    "encoding": "UTF-8",
    "bom": false,
    "line_endings": "LF",
    "final_newline": true,
    "custom_grouping_command": "python tools/format_blocks.py --check"
  },
  "mpi_boundary": {
    "native_units": [
      "src/parallel/MpiNative.cpp",
      "src/parallel/MpiNativeCollectives.cpp",
      "src/parallel/MpiNativeGhost.cpp",
      "src/parallel/MpiNativePackets.cpp",
      "src/parallel/MpiNativeState.hpp"
    ],
    "test_native_units": ["tests/Mpi.cpp", "tests/MpiFixture.cpp"],
    "scan_roots": ["src", "tests"],
    "suffixes": [".c", ".cc", ".cpp", ".cu", ".h", ".hip", ".hpp", ".inl"]
  },
